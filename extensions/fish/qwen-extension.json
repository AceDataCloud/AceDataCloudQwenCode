{
  "name": "fish-audio-by-ace-data-cloud",
  "version": "0.1.1",
  "displayName": "Fish Audio",
  "description": "Generate speech with Fish Audio through Ace Data Cloud and check an existing task. Read the local usage guide before synthesis.",
  "contextFileName": "QWEN.md",
  "mcpServers": {
    "fish": {
      "command": "uvx",
      "args": [
        "mcp-fish==2026.11.27.0"
      ],
      "env": {
        "ACEDATACLOUD_API_TOKEN": "${ACEDATACLOUD_FISH_TOKEN}"
      },
      "includeTools": [
        "fish_get_usage_guide",
        "fish_generate_audio",
        "fish_get_task",
        "fish_get_tasks_batch"
      ]
    }
  }
}
