{
  "name": "happyhorse-by-ace-data-cloud",
  "version": "0.1.0-rc.3",
  "description": "Generate and edit HappyHorse videos through Ace Data Cloud; retrieve the original task.",
  "mcpServers": {
    "happyhorse": {
      "httpUrl": "https://happyhorse.mcp.acedata.cloud/mcp",
      "headers": {
        "Authorization": "Bearer $ACE_HAPPYHORSE_API_TOKEN"
      },
      "includeTools": [
        "happyhorse_list_models",
        "happyhorse_generate_video",
        "happyhorse_generate_video_from_image",
        "happyhorse_generate_video_from_references",
        "happyhorse_edit_video",
        "happyhorse_get_task",
        "happyhorse_get_tasks_batch"
      ]
    }
  }
}
