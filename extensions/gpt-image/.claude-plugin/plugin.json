{
  "name": "gpt-image-by-ace-data-cloud",
  "version": "0.1.0-rc.2",
  "description": "Generate and edit GPT Image pictures through Ace Data Cloud, with async task retrieval.",
  "mcpServers": {
    "gpt-image": {
      "command": "uvx",
      "args": [
        "--from",
        "mcp-openai-pro==2026.10.19.5",
        "mcp-openai-pro",
        "--profile",
        "gpt-image"
      ],
      "env": {
        "ACEDATACLOUD_API_TOKEN": "$ACE_GPT_IMAGE_API_TOKEN"
      },
      "includeTools": [
        "gpt_image_generate",
        "gpt_image_edit",
        "gpt_image_get_task",
        "gpt_image_list_tasks",
        "gpt_image_list_models"
      ]
    }
  }
}
